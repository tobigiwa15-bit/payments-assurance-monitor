# Template for your own .env file. Copy it to .env and fill in real values.
# .env is git-ignored; never commit real keys.

# Claude API key from platform.claude.com (API Keys page)
ANTHROPIC_API_KEY=your-claude-api-key

# Your Google Cloud project ID
GCP_PROJECT_ID=your-gcp-project-id

# Full path to your BigQuery service-account key file (keep it outside this folder)
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
